<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <!-- Your TV Calendar: one scrollable page, a header row per followed show with its episodes under it.
         Laid out like the skin menus of TMDb Helper: poster and description on the left, flat rows on the right, one teal selection bar.
         Uses only font12/font13/font37 (present in Estuary and Titan) and the media calendar_bg.png / white.png.
         Properties set by resources/tmdbhelper/lib/window/showcalendar.py:
           window: window_title, center_label, view_unwatched, empty_text
           window: also day_mode (the All calendar), not_today (set when another day than today is open: shows the Today button)
           rows:   row_type (show / episode), show_summary, air_state (watched / aired / today / unaired), air_status, row_date,
                   air_time (the local air time, from the calendar episode item; empty on Unwatched rows) -->
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>
    <defaultcontrol always="true">1000</defaultcontrol>
    <controls>

        <!-- Background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <aspectratio>stretch</aspectratio>
            <texture>calendar_bg.png</texture>
        </control>

        <!-- Title and what the page shows (date span, or the show whose unwatched episodes are listed) -->
        <control type="label">
            <left>40</left>
            <top>22</top>
            <width>1100</width>
            <height>44</height>
            <font>font37</font>
            <textcolor>FFFFFFFF</textcolor>
            <aligny>center</aligny>
            <label>$INFO[Window.Property(window_title)]</label>
        </control>
        <control type="label">
            <left>360</left>
            <top>68</top>
            <width>1200</width>
            <height>48</height>
            <font>font37</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <label>[B]$INFO[Window.Property(center_label)][/B]</label>
        </control>

        <!-- Back (unwatched view only) and Close -->
        <control type="group">
            <left>1410</left>
            <top>26</top>
            <control type="button" id="3004">
                <left>0</left>
                <top>0</top>
                <width>150</width>
                <height>50</height>
                <font>font12</font>
                <label>Today</label>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus colordiffuse="FF0F89AE">white.png</texturefocus>
                <texturenofocus colordiffuse="33FFFFFF">white.png</texturenofocus>
                <onright>3001</onright>
                <ondown>1000</ondown>
                <visible>String.IsEqual(Window.Property(day_mode),True) + String.IsEmpty(Window.Property(view_unwatched)) + !String.IsEmpty(Window.Property(not_today))</visible>
            </control>
            <control type="button" id="3001">
                <left>160</left>
                <top>0</top>
                <width>70</width>
                <height>50</height>
                <font>font12</font>
                <label>&lt;</label>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus colordiffuse="FF0F89AE">white.png</texturefocus>
                <texturenofocus colordiffuse="33FFFFFF">white.png</texturenofocus>
                <onleft>3004</onleft>
                <onright>3002</onright>
                <ondown>1000</ondown>
                <visible>String.IsEqual(Window.Property(day_mode),True) + String.IsEmpty(Window.Property(view_unwatched))</visible>
            </control>
            <control type="button" id="3002">
                <left>240</left>
                <top>0</top>
                <width>70</width>
                <height>50</height>
                <font>font12</font>
                <label>&gt;</label>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus colordiffuse="FF0F89AE">white.png</texturefocus>
                <texturenofocus colordiffuse="33FFFFFF">white.png</texturenofocus>
                <onleft>3001</onleft>
                <onright>2999</onright>
                <ondown>1000</ondown>
                <visible>String.IsEqual(Window.Property(day_mode),True) + String.IsEmpty(Window.Property(view_unwatched))</visible>
            </control>
            <control type="button" id="3003">
                <left>160</left>
                <top>0</top>
                <width>150</width>
                <height>50</height>
                <font>font12</font>
                <label>Back</label>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus colordiffuse="FF0F89AE">white.png</texturefocus>
                <texturenofocus colordiffuse="33FFFFFF">white.png</texturenofocus>
                <onright>2999</onright>
                <ondown>1000</ondown>
                <visible>!String.IsEmpty(Window.Property(view_unwatched))</visible>
            </control>
            <control type="button" id="2999">
                <left>320</left>
                <top>0</top>
                <width>150</width>
                <height>50</height>
                <font>font12</font>
                <label>Close</label>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus colordiffuse="FF0F89AE">white.png</texturefocus>
                <texturenofocus colordiffuse="33FFFFFF">white.png</texturenofocus>
                <onleft>3002</onleft>
                <ondown>1000</ondown>
            </control>
